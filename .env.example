# ==============================================================================
# AI-Powered Resume Analysis & Intelligent Job Recommendation System
# Copy this file to `.env` and fill in your credentials. Never commit `.env`.
# ==============================================================================

# LLM Provider Selection: gemini | openai | ollama | demo
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Base URL (optional, if running Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration (SQLite default; optional MongoDB URI for cloud deployments)
DB_PATH=data/app.db
MONGODB_URI=

# Job Search & Scraper Settings
# Note: Set ENABLE_SELENIUM_SCRAPER=true only if Chrome/ChromeDriver is installed locally
# and you are authorized to query the target source. Public API sources run without Selenium.
ENABLE_SELENIUM_SCRAPER=false
SELENIUM_HEADLESS=true
SCRAPER_RATE_LIMIT_SECONDS=2.5

# Optional LinkedIn Credentials (leave empty unless explicitly testing authorized browser session)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
